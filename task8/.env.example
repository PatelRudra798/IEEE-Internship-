# FastAPI Backend Configuration
PORT=8000
HOST=0.0.0.0

# LLM Providers Configuration
# Supported providers: ollama, openai, gemini
LLM_PROVIDER=ollama

# Ollama settings
# When running inside Docker, host.docker.internal points to the host machine
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# OpenAI API Key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API Key (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding & Vector DB Config
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_DB_PATH=./chroma_db
UPLOADS_PATH=./uploads
TOP_K=5
